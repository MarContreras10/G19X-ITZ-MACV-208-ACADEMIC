# Copia este archivo como ".env" y completa los valores. El archivo ".env" NO se sube a Git.

# Clave secreta de Django (obligatoria). Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True solo en tu computadora de desarrollo; en un servidor debe ser False.
DJANGO_DEBUG=True

# Dominios o IPs desde los que se puede acceder, separados por comas.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
